<div class="mt-18 max-w-4xl mx-auto p-6 mt-10 bg-white rounded-lg shadow-lg">
  <h2 class="text-2xl font-bold mb-6 text-center">Your Test Attempts</h2>

  <% if @attempts.any? %>
    <table class="min-w-full mx-auto border text-center text-sm text-gray-700">
      <thead class="bg-gray-100 font-semibold uppercase">
        <tr>
          <th class="px-4 py-2">Test Title</th>
          <th class="px-4 py-2">Score</th>
          <th class="px-4 py-2">Total Questions</th>
          <th class="px-4 py-2">View</th>
        </tr>
      </thead>
      <tbody>
        <% @attempts.each do |attempt| %>
          <tr class="border-t hover:bg-gray-50">
            <td class="px-4 py-2"><%= attempt.test.title %></td>
            <td class="px-4 py-2"><%= attempt.score %></td>
            <td class="px-4 py-2"><%= attempt.test.questions.count %></td>
            <td class="px-4 py-2">
              <%= link_to "View", attempt_path(attempt), class: "text-blue-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-center text-gray-600">You have not attempted any tests yet.</p>
  <% end %>
</div>
