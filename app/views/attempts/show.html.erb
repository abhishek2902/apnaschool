<div class="mt-18 md:w-1/2 mx-auto min-h-screen flex items-center justify-center md:p-6">
  <div class="bg-white shadow-lg rounded-lg w-full max-w-3xl p-6">
    <h2 class="text-2xl font-semibold mb-4 text-center text-blue-700">
      Your Responses for Test: <%= @test.title %>
    </h2>

    <% @test.questions.each_with_index do |question, index| %>
      <% response = @attempt.responses.find_by(question_id: question.id) %>
      <% correct = response&.selected_option == question.correct_option %>

      <div class="mb-4 p-4 border rounded-lg <%= correct ? 'border-green-400 bg-green-50' : 'border-red-400 bg-red-50' %>">
        <p class="font-semibold text-lg text-gray-800 mb-2">
              Q<%= index + 1 %>: <%= question.content %>
        </p>
        <ul class="ml-4 text-sm">
          <li>A. <%= question.option_a %></li>
          <li>B. <%= question.option_b %></li>
          <li>C. <%= question.option_c %></li>
          <li>D. <%= question.option_d %></li>
        </ul>

        <div class="mt-3 text-sm">
          <p><strong>Your Answer:</strong> <%= response&.selected_option || "Not Answered" %></p>
          <p><strong>Correct Answer:</strong> <%= question.correct_option %></p>
        </div>

        <% if correct %>
          <p class="text-green-600 mt-2 font-medium">✅ Correct</p>
        <% else %>
          <p class="text-red-600 mt-2 font-medium">❌ Incorrect</p>
        <% end %>
      </div>
    <% end %>

    <div class="mt-4 text-center">
      <%= link_to "← Back", attempts_path, class: "inline-block text-white bg-blue-600 hover:bg-blue-700 font-semibold py-2 px-4 rounded-md" %>
    </div>
  </div>
</div>
