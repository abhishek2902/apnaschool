<div class="mt-18 flex justify-center items-center min-h-screen">
  <div class="bg-white p-6 rounded-lg shadow-lg w-[400px]">
    <h2 class="text-2xl font-bold text-center text-gray-800 mb-4">Log In</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), class: "space-y-4") do |f| %>
      <!-- Email Field -->
      <div>
        <%= f.label :email, class: "block font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-2 border rounded-md focus:ring focus:ring-blue-300" %>
      </div>

      <!-- Password Field -->
      <div>
        <%= f.label :password, class: "block font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "w-full px-4 py-2 border rounded-md focus:ring focus:ring-blue-300" %>
      </div>

      <!-- Remember Me Checkbox -->
      <% if devise_mapping.rememberable? %>
        <div class="flex items-center">
          <%= f.check_box :remember_me, class: "mr-2" %>
          <%= f.label :remember_me, class: "text-gray-700" %>
        </div>
      <% end %>

      <!-- Submit Button -->
      <div class="flex justify-center">
        <%= f.submit "Log In", class: "w-full bg-blue-500 hover:bg-blue-600 font-semibold py-2 rounded-md shadow-md transition duration-300" %>
      </div>
    <% end %>

    <div class="text-center mt-3 text-gray-600">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
