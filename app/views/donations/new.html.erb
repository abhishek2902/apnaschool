<div class="mt-18 flex flex-col items-center bg-gray-100 p-6 rounded-lg shadow-lg md:w-1/2 mx-auto">
  <h1 class="text-2xl font-bold text-gray-800 mb-4">Donate to Our School</h1>

  <%= form_tag("/donate", method: "post", class: "w-full") do %>
    <div class="mb-4">
      <label class="block text-gray-700 font-semibold">Donation Amount ($):</label>
      <%= number_field_tag :amount, 1, step: 0.01, class: "w-full p-2 mt-1 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none" %>
    </div>

    <%= submit_tag "Donate with PayPal", class: "w-full bg-blue-600 text-white font-semibold py-2 rounded-lg hover:bg-blue-700 transition duration-200" %>
  <% end %>
</div>
