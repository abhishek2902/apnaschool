

<div class="max-w-2xl mx-auto mt-36 px-4">
  <div class="bg-white shadow-md rounded-2xl p-6">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">🧠 Ask a Doubt</h2>

    <%= form_with model: @doubt, local: true do |f| %>
      <div class="mb-6">
        <%= f.label :question, "Your Question", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_area :question, rows: 5, placeholder: "Type your study-related doubt here...", class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-800" %>
      </div>

      <div class="text-right">
        <%= link_to "Back", doubts_path, class: "mt-2 ml-2 text-blue-800 bg-transparent border border-blue-800 hover:bg-blue-900 hover:text-white focus:ring-4 focus:outline-none focus:ring-blue-200 font-medium rounded-lg text-xs px-4 py-2 text-center dark:hover:bg-blue-600 dark:border-blue-600 dark:text-blue-400 dark:hover:text-white dark:focus:ring-blue-800" %>

        <%= f.submit "Submit", class: "mt-2 ml-2 text-blue-800 bg-transparent border border-blue-800 hover:bg-blue-900 hover:text-white focus:ring-4 focus:outline-none focus:ring-blue-200 font-medium rounded-lg text-xs px-4 py-1.5 text-center dark:hover:bg-blue-600 dark:border-blue-600 dark:text-blue-400 dark:hover:text-white dark:focus:ring-blue-800" %>
      </div>
    <% end %>
  </div>
</div>
