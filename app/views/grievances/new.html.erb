<div class="max-w-lg mx-auto p-6 bg-white shadow-lg rounded-lg mt-18">
  <h2 class="text-2xl font-semibold text-gray-800 mb-4 text-center">Submit a Complaint</h2>
  
  <%= form_with model: @grievance, local: true, class: "space-y-4" do |f| %>
    
    <!-- Name Field -->
    <% if current_user %>
      <!-- Hidden Field to Store User's Name -->
      <%= f.hidden_field :name, value: current_user.name %>
    <% else %>
      <div>
        <%= f.label :name, "Your Name", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :name, required: true, placeholder: "Enter your name",
              class: "mt-1 block w-full px-4 py-2 border rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>
    <% end %>
    
    <!-- Complaint Content -->
    <div>
      <%= f.label :text, "Complaint", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :text, required: true, rows: 4, placeholder: "Describe your complaint",
            class: "mt-1 block w-full px-4 py-2 border rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
    </div>
    
    <!-- Submit Button -->
    <div class="text-center">
      <%= f.submit "Submit Complaint", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg shadow-md transition duration-200" %>
    </div>

  <% end %>
</div>
