<div class="m-5 mt-18 sm:m-18 md:w-1/2">
  <% if  current_user && (current_user.admin? || current_user.teacher?) %>
    <%= link_to "Add Notice", new_notice_path, class: "text-white bg-blue-800 hover:bg-blue-900 focus:ring-4 focus:outline-none focus:ring-blue-200 font-medium rounded-lg text-xs px-3 py-1.5 me-2 mb-4 text-center inline-flex items-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800" %>
  <% end %>

  <% @notices.each do |notice| %>
  
    <div id="alert-additional-content-1" class="relative p-4 mb-4 text-blue-800 border border-blue-300 rounded-lg bg-blue-50 dark:bg-gray-800 dark:text-blue-400 dark:border-blue-800" role="alert">
    
      <div class="flex items-center">
        <svg class="shrink-0 w-4 h-4 me-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
        </svg>
        <span class="sr-only">Info</span>
        <h3 class="text-lg font-medium"><%= notice.title %></h3>
      </div>
      <div class="mt-2 mb-4 text-sm">
        <%= notice.text %>
      </div>
      <div class="flex">
         <%= button_to "Show", notice_path(notice),method: :get, class: "ml-2 text-blue-800 bg-transparent border border-blue-800 hover:bg-blue-900 hover:text-white focus:ring-4 focus:outline-none focus:ring-blue-200 font-medium rounded-lg text-xs px-3 py-1.5 text-center dark:hover:bg-blue-600 dark:border-blue-600 dark:text-blue-400 dark:hover:text-white dark:focus:ring-blue-800" %>
         <% if  current_user && (current_user.admin? || current_user.teacher?) %>
          <%= button_to "Edit", edit_notice_path(notice),method: :get, class: "ml-2 text-blue-800 bg-transparent border border-blue-800 hover:bg-blue-900 hover:text-white focus:ring-4 focus:outline-none focus:ring-blue-200 font-medium rounded-lg text-xs px-3 py-1.5 text-center dark:hover:bg-blue-600 dark:border-blue-600 dark:text-blue-400 dark:hover:text-white dark:focus:ring-blue-800" %>
         <% end %>
         <% if  current_user && current_user.admin? %>
          <%= button_to "Delete", notice_path(notice),method: :delete, class: "ml-2 text-blue-800 bg-transparent border border-blue-800 hover:bg-blue-900 hover:text-white focus:ring-4 focus:outline-none focus:ring-blue-200 font-medium rounded-lg text-xs px-3 py-1.5 text-center dark:hover:bg-blue-600 dark:border-blue-600 dark:text-blue-400 dark:hover:text-white dark:focus:ring-blue-800" %>
         <% end %>
        <!-- Like Button & Like Count -->
        <div class="flex items-center mt-2">
          <%= button_to like_notice_path(notice), method: :patch, class: "text-blue-800 hover:text-blue-900 focus:outline-none " do %>
            👍 <span class="text-sm"><%= notice.likes %></span>
          <% end %>
        </div>
        <!-- date time -->
        <div class="mt-2 flex absolute bottom-0 sm:bottom-2 right-4 text-sm">
          <%= notice.created_at.strftime("%d %b %Y, %I:%M %p") %>
        </div>
      </div>
      
    </div>
  <% end %>
</div>
