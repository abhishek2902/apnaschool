<div class="h-screen flex items-center justify-center ">
    <div class="md:w-1/2 mx-auto mt-18 bg-white p-4 rounded-2xl shadow-lg">
    <h2 class="text-2xl font-semibold text-center text-gray-800 mb-6">Create a New Test</h2>

    <%= form_with model: @test, local: true do |form| %>
        <div class="mb-4">
        <%= form.label :title, "Test Title", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :title, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
        </div>

        <div class="text-center">
        <%= form.submit "Create Test", class: "bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition-all duration-200" %>
        </div>
    <% end %>
    </div>
</div>
